generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  role      Role       @default(MEMBER)
  leads     Lead[]     // Assigned leads
  notes     LeadNote[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Lead {
  id          String     @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  company     String?
  phone       String?
  status      LeadStatus @default(NEW)
  
  assignedToId String?
  assignedTo   User?      @relation(fields: [assignedToId], references: [id])
  
  notes       LeadNote[]
  activities  Activity[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model LeadNote {
  id        String   @id @default(uuid())
  content   String
  
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id          String   @id @default(uuid())
  action      String   // e.g., "STATUS_CHANGED", "NOTE_ADDED", "LEAD_CREATED"
  description String   // e.g., "Lead status changed from NEW to CONTACTED"
  
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}
