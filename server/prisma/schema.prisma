generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  MANUAL
  OTHER
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  name         String
  role         Role       @default(MEMBER)
  isActive     Boolean    @default(true)
  
  assignedLeads Lead[]    @relation("AssignedLeads")
  createdLeads  Lead[]    @relation("CreatedLeads")
  notes         LeadNote[]
  tasks         Task[]
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Lead {
  id            String      @id @default(cuid())

  // Basic Information
  firstName     String
  lastName      String?
  email         String
  phone         String
  company       String?
  message       String?

  // Business
  status        LeadStatus  @default(NEW)
  source        LeadSource  @default(WEBSITE)

  // Assignment
  assignedToId  String?
  assignedTo    User?       @relation("AssignedLeads", fields: [assignedToId], references: [id])

  // Creator
  createdById   String?
  createdBy     User?       @relation("CreatedLeads", fields: [createdById], references: [id])

  // Future Integrations
  externalReference String?

  // Relations
  notes         LeadNote[]
  activities    Activity[]
  tasks         Task[]

  // Audit
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model LeadNote {
  id        String   @id @default(uuid())
  content   String
  
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id          String   @id @default(uuid())
  action      String   // e.g., "STATUS_CHANGED", "NOTE_ADDED", "LEAD_CREATED"
  description String   // e.g., "Lead status changed from NEW to CONTACTED"
  
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model Task {
  id          String   @id @default(uuid())
  title       String
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  assignedToId String
  assignedTo   User     @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}
